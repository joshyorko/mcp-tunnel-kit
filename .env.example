# Copy to the ignored repo-local .env. Keep an existing .env when updating.
# Fill these three credentials privately in your editor, then run:
# ./scripts/control-plane-up
# Uncomment each supplied value. Omit keys to retain existing private files.
# Blank assignments fail closed. Never commit your filled .env or share it.
# CONTROL_PLANE_API_KEY=your-existing-control-plane-key
# CONTROL_PLANE_TUNNEL_ID=tunnel_your-existing-32-hex-character-id
# EXECUTOR_PAT=your-browser-created-organization-pat
# Fresh Executor: run --first-run, finish browser setup, then add the PAT here.
# The helper makes .env mode 0600 and derives the file-backed Bearer header.

# Preserve these machine-local settings and the selected state/socket paths.
CAS_IMAGE=ghcr.io/joshyorko/codex-action-server@sha256:a50b016f04f1cc6892a1d688d5c797f5c8a5e4e201239d8a6ef9f577d80ed614
CAS_TARGETS_SOURCE=/absolute/path/to/operator-owned/targets.json
CAS_UID=1000
CAS_GID=1000
NATIVE_CODEX_SOCKET_DIR=/tmp/codex-daemon-1000
CONTROL_PLANE_STATE_DIR=${HOME}/.local/share/codex-control-plane
CONTROL_PLANE_SECRET_DIR=${HOME}/.local/share/codex-control-plane/secrets
# Preserve existing stores during cutover. Leave unset only for a fresh install.
# CAS_RUNTIME_DIR=${HOME}/.local/state/codex-action-server/runtime
# CAS_RECEIPTS_DIR=${HOME}/.local/state/codex-action-server/receipts
CONTROL_PLANE_SUBNET=172.30.86.0/24
CONTROL_PLANE_GATEWAY=172.30.86.1
# Optional local acceptance override: COMPOSE_FILE=compose.yaml:compose.local.yaml
CAS_SOURCE_PATH=../codex-action-server
# Optional existing Devsy state: add compose.devsy.yaml to COMPOSE_FILE.
# DEVSY_HOME=/absolute/path/to/existing/devsy
# DEVSY_CONFIG_FILE=/absolute/path/to/existing/devsy/config.yaml
# DEVSY_CONTEXT_DIR=/absolute/path/to/existing/devsy/contexts/default
# DEVSY_KUBECONFIG_FILE=/absolute/path/to/existing/.kube/config
# DEVSY_CONTEXT=default
