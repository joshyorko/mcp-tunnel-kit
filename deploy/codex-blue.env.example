# Operator supplies existing BLUE tunnel values locally. Never commit the real file.
CODEX_TUNNEL_KIT_ROOT=/absolute/path/to/pinned/mcp-tunnel-kit
CODEX_CHECK_PYTHON=/absolute/path/to/pinned/mcp-tunnel-kit/.venv/bin/python
TUNNEL_CLIENT_BIN=/home/USER/.local/bin/tunnel-client
CODEX_MCP_URL=http://127.0.0.1:8088/mcp
CONTROL_PLANE_API_KEY=REPLACE_LOCALLY_WITH_EXISTING_BLUE_KEY
CONTROL_PLANE_TUNNEL_ID=REPLACE_LOCALLY_WITH_EXISTING_BLUE_TUNNEL_ID
PATH=/home/USER/.local/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin
