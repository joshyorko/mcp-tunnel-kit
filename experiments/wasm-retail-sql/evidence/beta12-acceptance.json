        "orderRows": 50000,
        "inventoryRows": 100,
        "queryOnly": true,
        "sql": "SELECT i.category, COUNT(*) AS orders, SUM(o.units) AS units,\n      SUM(o.revenue_cents) AS revenue_cents, SUM(o.cost_cents) AS cost_cents,\n      SUM(o.revenue_cents-o.cost_cents) AS margin_cents,\n      ROUND(100.0*SUM(o.revenue_cents-o.cost_cents)/SUM(o.revenue_cents),2) AS margin_pct\n      FROM orders o JOIN inventory i ON i.sku=o.sku\n      GROUP BY i.category ORDER BY margin_cents DESC, i.category LIMIT 5"
      }
