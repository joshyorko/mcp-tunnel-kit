{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joshyorko/codex-action-server/blob/main/.github/schemas/cas-qualified-release-v1.schema.json",
  "title": "Qualified CAS release handoff v1",
  "description": "CAS-owned evidence consumed by mcp-tunnel-kit before opening a production image promotion PR.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "qualification", "publication", "receipt_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 of canonical sorted-key compact JSON for this object without receipt_sha256."
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "merged", "commit_url"],
      "properties": {
        "repository": {"const": "joshyorko/codex-action-server"},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "merged": {"const": true},
        "commit_url": {"type": "string", "format": "uri", "pattern": "^https://github\\.com/joshyorko/codex-action-server/commit/[0-9a-f]{40}$"}
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
        "required": ["status", "run_url", "required_ci_url", "comparison_url", "native_release", "surface", "method_verdicts", "behavior_coverage", "withheld_methods"],
      "properties": {
        "status": {"const": "qualified"},
        "run_url": {"$ref": "#/$defs/runUrl"},
        "required_ci_url": {"$ref": "#/$defs/runUrl"},
        "comparison_url": {"type": "string", "format": "uri", "pattern": "^https://github\\.com/joshyorko/codex-action-server/compare/[A-Za-z0-9._/-]+$"},
          "native_release": {
            "type": "object",
            "additionalProperties": false,
            "required": ["version", "tag", "asset_url", "asset_id", "asset_sha256", "binary_sha256", "fixture_path", "fixture_sha256", "qualification_run_url"],
            "properties": {
              "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
              "tag": {"type": "string", "pattern": "^rust-v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
              "asset_url": {"type": "string", "format": "uri", "pattern": "^https://github\\.com/openai/codex/releases/download/rust-v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)/codex-x86_64-unknown-linux-musl\\.tar\\.gz$"},
              "asset_id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
              "asset_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "binary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "fixture_path": {"type": "string", "pattern": "^tests/fixtures/protocol/[A-Za-z0-9._-]+\\.json$"},
              "fixture_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "qualification_run_url": {"$ref": "#/$defs/runUrl"}
            }
          },
        "surface": {
          "type": "object",
          "additionalProperties": false,
          "required": ["complete", "sha256", "methods"],
          "properties": {
            "complete": {"const": true},
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "description": "SHA-256 of the canonical sorted method rows (compact sorted-key JSON array, sorted by name)."
            },
            "methods": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "owner"],
                "properties": {
                  "name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_./-]{0,127}$"},
                  "owner": {"enum": ["typed_action", "shared_helper"]}
                }
              }
            }
          }
        },
        "method_verdicts": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"enum": ["qualified", "already_approved"]}
        },
        "behavior_coverage": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["result", "strategy"],
            "properties": {
              "result": {"const": "passed"},
              "strategy": {"enum": ["native_read_smoke", "isolated_fixture"]}
            }
          }
        },
        "withheld_methods": {"type": "array", "maxItems": 0}
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "run_url", "image_repository", "image_tag", "digest", "revision", "platform"],
      "properties": {
        "status": {"const": "published"},
        "run_url": {"$ref": "#/$defs/runUrl"},
        "image_repository": {"const": "ghcr.io/joshyorko/codex-action-server"},
        "image_tag": {"type": "string", "pattern": "^sha-[0-9a-f]{40}$"},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "platform": {"const": "linux/amd64"}
      }
    }
  },
  "$defs": {
    "runUrl": {"type": "string", "format": "uri", "pattern": "^https://github\\.com/joshyorko/codex-action-server/actions/runs/[1-9][0-9]*$"}
  }
}
