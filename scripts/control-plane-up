#!/usr/bin/env bash
set +x
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
mode=up
case "${1:-}" in
  "") ;;
  --first-run) mode=first-run ;;
  --secrets) mode=secrets ;;
  --check) mode=check ;;
  --restart-devsy) mode=restart-devsy ;;
  --restart-cas) mode=restart-cas ;;
  *) printf '%s\n' 'usage: scripts/control-plane-up [--first-run|--secrets|--check|--restart-devsy|--restart-cas]' >&2; exit 2 ;;
esac
[[ $# -le 1 ]] || { printf '%s\n' 'Use one mode only.' >&2; exit 2; }
exec "${CONTROL_PLANE_PYTHON:-python3}" scripts/compose_control.py "$mode"
