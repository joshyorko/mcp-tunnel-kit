{
  "enabled": false,
  "principal": "authenticated_owner_private_profile",
  "context": "default",
  "provider": "kubernetes",
  "kubernetes_context": "ror",
  "namespace": "devsy",
  "namespace_must_exist": true,
  "repository": "https://github.com/joshyorko/codex-action-server.git",
  "source_ref": "refs/heads/main",
  "recipe": "Containerfile.worker",
  "source_kind": "image",
  "image_repository": "ghcr.io/joshyorko/codex-action-server",
  "allowed_new_names": ["cas-worker-01", "rcc-worker-01"],
  "protected_names": ["codex-action-server"],
  "max_active_workspaces": 2,
  "max_pending_creates": 1,
  "job_timeout_seconds": 1200,
  "capability_ttl_seconds": null,
  "no_browser_tool_names": ["workspace_create_scoped", "workspace_start_scoped"],
  "read_tool_names": ["workspace_status_scoped", "workspace_create_receipt"],
  "automatic_target_rebind": false
}
